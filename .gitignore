# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output
/.next/
/out/

# production & build
/build
/dist
/.turbo

# misc & OS files
.DS_Store
Thumbs.db
desktop.ini

# certificates & private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets / credentials)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env*

# agent & IDE configs containing local skills, API keys, or editor state
.agents/
.gemini/
.vscode/
.idea/

# vercel
.vercel

# typescript build info
*.tsbuildinfo
next-env.d.ts
